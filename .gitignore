# ============================================
# GLANDIA - .gitignore
# ============================================

# ---------- Dépendances ----------
node_modules/
jspm_packages/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ---------- Builds / Sorties ----------
dist/
build/
out/
.vite/
*.local

# ---------- Variables d'environnement (SECRETS) ----------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.env

# ---------- Logs ----------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/
*.log

# ---------- Cache & divers ----------
.cache/
.parcel-cache/
.temp/
.tmp/
*.tsbuildinfo
.eslintcache
.stylelintcache
.npm
.yarn-integrity

# ---------- Système d'exploitation ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---------- Éditeurs / IDE ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ---------- Docker (configs locales) ----------
# On ignore les overrides locaux, mais on garde docker-compose.yml
docker-compose.override.yml
docker-compose.local.yml
*.dockerignore.local

# ---------- Données locales montées sur le NAS ----------
# NE JAMAIS versionner les données utilisateur / corrections
data.json.bak
corrections.json.bak
*.bak
*.backup

# ---------- Secrets / Clés / Certificats ----------
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
*.secret

# ---------- Tailscale (TRÈS IMPORTANT) ----------
# Ne jamais publier les configs / clés Tailscale
tailscale/
*.tailscale
tailscale.state
tailscaled.state

# ---------- Capacitor / Android ----------
# On garde le code source Android, mais pas les builds
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/captures/
android/app/release/
android/app/debug/
*.apk
*.aab
*.keystore
*.jks
keystore.properties

# ---------- iOS (si un jour) ----------
ios/App/Pods/
ios/App/build/
ios/App/DerivedData/
ios/App/Podfile.lock
*.ipa
*.mobileprovision

# ---------- Fichiers spécifiques GLANDIA ----------
# Config locale du projet (à créer en local, pas versionnée)
config.local.js
config.local.json
src/config.local.js
vite.config.local.js
